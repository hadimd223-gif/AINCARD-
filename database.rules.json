{
  "rules": {
    "admins": { ".read": "auth != null && root.child('admins').child(auth.uid).exists()", ".write": false },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).exists())",
        "name":    { ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).exists())" },
        "email":   { ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).exists())" },
        "createdAt": { ".write": "auth != null && auth.uid == $uid && !data.exists()" },
        "code":    { ".write": "auth != null && ((auth.uid == $uid && !data.exists()) || root.child('admins').child(auth.uid).exists())" },
        "banned":  { ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (auth.uid == $uid && newData.val() === true))" }
      }
    },
    "sessions": { "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth != null && auth.uid == $uid" } },
    "claims":   { "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth != null && auth.uid == $uid" } },
    "keyIds": {
      ".read": "auth != null",
      "$id": { ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || newData.val() === null)" }
    },
    "keys": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || newData.val() === null)"
      }
    }
  }
}
